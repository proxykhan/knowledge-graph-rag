# Copy this file to .env and fill in the values. Never commit .env.

# Which model answers questions (routing, answers, group labels): gemini | ollama | claude
LLM_PROVIDER=gemini
# Which model built the graph (its cached extractions are keyed by this model)
EXTRACTION_PROVIDER=gemini

# Local model through Ollama (free, unlimited): install from ollama.com, then `ollama pull qwen3:8b`
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Gemini, free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Claude API key, only if LLM_PROVIDER=claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# Only needed if your API key is not scoped to a workspace (Console > Workspaces > ID)
ANTHROPIC_WORKSPACE_ID=

# SEC EDGAR requires a User-Agent identifying you: "Your Name your@email.com"
# https://www.sec.gov/os/accessing-edgar-data
SEC_USER_AGENT=

# Local dev databases (must match docker-compose.yml)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=kgrag-dev-password
POSTGRES_DSN=postgresql://kgrag:kgrag-dev-password@localhost:5432/kgrag

# Free local embedding model (sentence-transformers)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
